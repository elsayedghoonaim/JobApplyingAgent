# Database
JOBAPPLY_MONGODB_URL=mongodb://localhost:27017
JOBAPPLY_MONGODB_DB=jobapply
JOBAPPLY_SEEN_JOBS_COLLECTION=seen_jobs
JOBAPPLY_MANUAL_REVIEW_COLLECTION=manual_review_queue
JOBAPPLY_CANDIDATE_FACTS_COLLECTION=candidate_facts
JOBAPPLY_CANDIDATE_FACT_VALIDITY_DAYS=365
JOBAPPLY_CANDIDATE_FACT_HISTORY_LIMIT=20

# Data directory
JOBAPPLY_DATA_DIR=user-data

# LLM provider: gemini or openrouter
JOBAPPLY_LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
JOBAPPLY_LLM_MODEL=gemma-4-31b-it
JOBAPPLY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Telegram
JOBAPPLY_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
JOBAPPLY_TELEGRAM_CHAT_ID=your-telegram-chat-id
JOBAPPLY_TELEGRAM_BOT_NAME=Magdy
JOBAPPLY_TELEGRAM_USER_TITLE=Boss
JOBAPPLY_TELEGRAM_QUESTION_LANGUAGE=English
JOBAPPLY_REPORT_TIMEZONE=Africa/Cairo

# LinkedIn and Edge
JOBAPPLY_LINKEDIN_BASE_URL=https://www.linkedin.com
JOBAPPLY_LINKEDIN_SIGNIN_TIMEOUT_SECONDS=600
JOBAPPLY_LINKEDIN_NAVIGATION_TIMEOUT_MS=60000
JOBAPPLY_EDGE_DEBUG_PORT=9222
JOBAPPLY_EDGE_AUTO_LAUNCH=true
JOBAPPLY_EDGE_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
JOBAPPLY_EDGE_USER_DATA_DIR=%LOCALAPPDATA%\JobApply\EdgeProfile
JOBAPPLY_HEADLESS=false

# Workflow behavior
JOBAPPLY_MAX_APPLICATIONS=50
JOBAPPLY_QUALIFICATION_THRESHOLD=0.7
JOBAPPLY_URGENT_EDIT_THRESHOLD=0.8
JOBAPPLY_ACTION_DELAY_MS=2000
JOBAPPLY_DELAY_JITTER_PERCENT=30
JOBAPPLY_JOB_LOAD_TIMEOUT_MS=3000
JOBAPPLY_DRY_RUN=true
JOBAPPLY_APPROVAL_TIMEOUT_SECONDS=300
JOBAPPLY_FORM_QA_TIMEOUT_SECONDS=300
JOBAPPLY_AUTO_ACCEPT_APPLICATION_TERMS=false
# Discovery searches. Use several related queries to find enough listings.
JOBAPPLY_SEARCH_QUERIES=Machine Learning Engineer,AI Engineer
# Strict title gate. A job title must contain at least one literal phrase below.
JOBAPPLY_TARGET_TITLE_KEYWORDS=Machine Learning,ML,MLOps,Deep Learning
# Set false if Senior/Lead/Staff/Principal/Manager titles are acceptable.
JOBAPPLY_EXCLUDE_SENIOR_TITLES=true
# Jobs that explicitly require another language are skipped.
JOBAPPLY_ALLOWED_LANGUAGES=Arabic,English
# Comma-separated locations that are always rejected before opening or applying.
JOBAPPLY_EXCLUDED_LOCATIONS=Palestine,Palastin,Palastine,State of Palestine,Palestinian Territory,Palestinian Territories,Israel,Israeli,West Bank,Gaza,Gaza Strip,Tel Aviv,Jerusalem,Haifa,Beer Sheva,Beersheba,Ashdod,Netanya,Petah Tikva,Rishon LeZion,Ramat Gan,Herzliya,فلسطين,إسرائيل,ישראל

# Search scope (CLI --location/--recency-days override these)
# Location is trimmed, bounded, and safely URL-encoded; default Worldwide.
JOBAPPLY_SEARCH_LOCATION=Worldwide
# Bounded recency window in days (1-30). Unset, empty, or 0 disables the filter.
JOBAPPLY_SEARCH_RECENCY_DAYS=

# Optional LangSmith tracing and privacy controls
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=false
LANGSMITH_PROJECT=jobapply-linkedin-agent
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
